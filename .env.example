# این فایل را کپی کنید به ".env" (کنار manage.py). حالا خودکار خوانده می‌شود.
DJANGO_SECRET_KEY=یک-رشته-تصادفی-طولانی
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# ── ایمیل ──
# بدون این بخش، ایمیل‌ها فقط داخل ترمینال چاپ می‌شوند (مناسب توسعه).
# برای ارسال واقعی (نمونه با جیمیل — باید «تأیید دومرحله‌ای» فعال و یک App Password ساخته باشید):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=app-password-16-chars
# DEFAULT_FROM_EMAIL=ویرابوم <youraddress@gmail.com>
